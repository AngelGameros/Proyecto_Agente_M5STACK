# Copy this file to .env and replace placeholders with local values.
DATABASE_URL=sqlite:///./smartfridge.db
API_BASE_URL=http://127.0.0.1:8000

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace_with_local_minio_user
MINIO_SECRET_KEY=replace_with_a_long_random_local_password
MINIO_SECURE=false
MINIO_BUCKET_TICKETS=purchase-tickets
MINIO_BUCKET_FOODS=food-images

VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_API_KEY=replace_with_your_vision_provider_key
VISION_MODEL=google/gemini-2.5-flash

WHATSAPP_PENDING_DIR=tickets/whatsapp/pending
WHATSAPP_PROCESSED_DIR=tickets/whatsapp/processed
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=replace_with_a_long_random_evolution_key
EVOLUTION_INSTANCE_NAME=SmartFridge
DEFAULT_USER_EMAIL=you@example.com

XIAOZHI_MCP_URL=

POSTGRES_DATABASE=evolution_db
POSTGRES_USERNAME=evolution_user
POSTGRES_PASSWORD=replace_with_a_long_random_postgres_password
